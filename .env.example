# Copy to .env.local for local development; set the same names in Vercel.
# Never commit real values, and never put HATS account logins in here.

# Neon Postgres connection string
DATABASE_URL=
# Passcode for the web UI
DASHBOARD_PASSWORD=
# Random string, 32+ characters (e.g. `openssl rand -base64 32`). Signs the session cookie.
SESSION_SECRET=
# Random string for the MCP bearer token (e.g. `openssl rand -hex 32`)
MCP_API_TOKEN=
# Public origin for short links, no trailing slash. Use a domain you will keep for years.
BASE_URL=http://localhost:3000
# Main TicketSource event page (https). Unknown or inactive QR slugs go here.
DEFAULT_DESTINATION_URL=
TZ=Europe/London
